OTARI_API_KEY=
OTARI_JUDGE_API_KEY=
OTARI_BASE_URL=https://api.otari.ai/api/v1
# service key (Create key, Advanced, Service key) and the end-user budgets it may start visitors on
OTARI_SERVICE_KEY=
SHOPGUARD_EU_VISITOR=
SHOPGUARD_EU_JUDGE=
SHOPGUARD_EU_TINY=
SHOPGUARD_EU_SALT=
# public https URL of this app, so Otari's cloud can reach /guard/<token>/validate and /mcp
SHOPGUARD_PUBLIC_URL=
SHOPGUARD_GUARD_TOKEN=
SHOPGUARD_MCP_TOKEN=
SHOPGUARD_MODEL_FAST=nvidia/nemotron-nano-3-30b
SHOPGUARD_MODEL_SMART=nvidia/nemotron-3-super-120b-a12b
SHOPGUARD_MODEL_SELLER=google/gemma-3-27b-it
# Otari routing policies per role; SHOPGUARD_ROUTING=off calls the models directly
SHOPGUARD_ROUTE_SELLER=shopguard-seller
SHOPGUARD_ROUTE_FAST=shopguard-extract
SHOPGUARD_ROUTE_SMART=shopguard-judge
SHOPGUARD_ROUTE_DRILL=shopguard-drill
SHOPGUARD_RATE_PER_IP_HOUR=20
SHOPGUARD_DAILY_SEARCH_CAP=25
SHOPGUARD_JUDGE_KEY=
SHOPGUARD_DB=/opt/shopguard/shopguard.db
# 1 only behind a proxy that replaces X-Forwarded-For (on Vercel the edge header is used instead)
SHOPGUARD_TRUST_PROXY=1
