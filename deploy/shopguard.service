[Unit]
Description=ShopGuard demo (FastAPI)
After=network.target

[Service]
User=shopguard
WorkingDirectory=/opt/shopguard
EnvironmentFile=/etc/shopguard.env
ExecStart=/opt/shopguard/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8765 --workers 1
Restart=on-failure
MemoryMax=300M
CPUQuota=50%
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/shopguard
PrivateTmp=true

[Install]
WantedBy=multi-user.target
